# Saat development, kosongkan agar Vite meneruskan /api dan /health ke localhost:8080.
# Untuk deployment terpisah, isi dengan URL backend Warta tanpa /api di belakangnya,
# lalu tambahkan origin frontend ke CORS_ORIGINS di backend.
VITE_API_URL=

# Dipakai middleware.js di Vercel (pratinjau link, sitemap, RSS). Kosong berarti
# memakai VITE_API_URL. Isi bila middleware harus memanggil backend lewat
# alamat lain.
API_URL=
